{
  "expo": {
    "name": "FitForge",
    "slug": "fitforge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "fitforge",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://fitforge-api.stackupai.in/manifest",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 300
    },
    "splash": {
      "backgroundColor": "#0a0a0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.suyeshbadge.fitforge",
      "infoPlist": {
        "NSCameraUsageDescription": "FitForge needs camera access for progress photos",
        "NSPhotoLibraryUsageDescription": "FitForge needs photo library access for progress photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.suyeshbadge.fitforge"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "FitForge needs camera access for progress photos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitForge needs photo library access for progress photos"
        }
      ]
    ]
  }
}
